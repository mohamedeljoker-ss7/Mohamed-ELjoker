rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      // Allow read access for published course media and require authentication + size limit for writes
      allow read: if true;
      allow write: if request.auth != null && request.resource.size < 100 * 1024 * 1024;
    }
  }
}



